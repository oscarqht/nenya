/* Common popup styles */

:root {
  --popup-width: 480px;
  --save-to-unsorted-popup-height: 560px;
}

/* Ensure html matches body width for Firefox */
html {
  width: var(--popup-width);
}

/* Popup width constraint - shared across all popup pages */
body {
  width: var(--popup-width);
  max-width: 100%;
  min-width: min(var(--popup-width), 100vw);
  min-height: 480px;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

@media (max-width: 479px) {
  body {
    min-width: 100%;
    width: 100%;
    min-height: 100vh;
    padding: 0.5rem;
  }
}


body.save-to-unsorted-dialog-open {
  min-height: var(--save-to-unsorted-popup-height);
}

.nenya-popup-body {
  padding: 0.75rem;
}

.nenya-popup-header {
  border: 1px solid var(--nenya-border-soft);
  border-radius: var(--nenya-radius-lg);
  box-shadow: var(--nenya-shadow-soft);
  background: color-mix(in oklch, var(--color-base-100) 90%, transparent);
  padding-inline: 0.5rem;
}

.nenya-popup-header .btn {
  border-radius: 999px;
}

#shortcutsContainer .btn {
  color: #2b211c;
}

#runCodeSection {
  border: 1px solid var(--nenya-border-soft);
  background: var(--color-base-100);
  backdrop-filter: none;
}

#runCodeList .run-code-item {
  --run-code-chip-height: 1.45rem;
  display: inline-flex;
  align-items: center;
  gap: 0.35rem;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  border-radius: 999px;
  box-shadow: 0 5px 14px rgb(0 0 0 / 0.08);
  background: #eee;
  color: #222;
  height: auto;
  min-height: var(--run-code-chip-height);
  padding: 0.2rem 0.6rem;
  font-size: 0.78rem;
  line-height: 1.1;
}

#runCodeList .run-code-shortcut-key {
  font-weight: 700;
  font-size: 0.68rem;
  line-height: 1;
  text-transform: uppercase;
  opacity: 0.72;
}

#runCodeList .run-code-item.is-running {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

#runCodeList .run-code-spinner {
  width: var(--run-code-chip-height);
  height: var(--run-code-chip-height);
  flex: 0 0 var(--run-code-chip-height);
  border: 0.18rem solid currentColor;
  border-right-color: transparent;
  border-radius: 999px;
  opacity: 0.45;
  animation: run-code-spinner 0.8s linear infinite;
}

@keyframes run-code-spinner {
  to {
    transform: rotate(360deg);
  }
}

[data-theme='dark'] #shortcutsContainer .btn {
  color: #f3ebe7;
}

[data-theme='dark'] #runCodeList .run-code-item {
  background: #333;
  color: #f3ebe7;
}

#bookmarksSearchInput {
  min-height: 2.8rem;
  height: auto;
  outline: none;
  box-shadow: none;
  resize: none;
  overflow-y: auto;
  line-height: 1.5;
  padding-top: 0.6rem;
  padding-bottom: 0.6rem;
}

#bookmarksSearchInput:focus {
  border-color: var(--nenya-accent);
  box-shadow: 0 0 0 4px color-mix(in oklch, var(--nenya-accent) 14%, transparent);
}

#customSearchSuggestions,
#bookmarksSearchResults {
  scrollbar-width: thin;
}

#bookmarksSearchResults > div {
  border-radius: var(--nenya-radius-md);
}

#bookmarksSearchResults > div:hover {
  background: color-mix(in oklch, var(--nenya-accent) 12%, var(--color-base-200));
}

#favoritesContainer .badge {
  border-radius: 999px;
  box-shadow: 0 5px 14px rgb(0 0 0 / 0.08);
}

#favoritesContainer .unpin-button {
  opacity: 0.65;
}

#favoritesContainer .badge:hover .unpin-button {
  opacity: 1;
}

.pin-button.is-favorite {
  opacity: 1;
  color: #b45309;
}

.favorites-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.35rem;
  width: 0.85rem;
  height: 0.85rem;
  border-radius: 999px;
  background: color-mix(in oklch, var(--color-base-200) 72%, transparent);
  color: color-mix(in oklch, var(--color-base-content) 68%, transparent);
  font-size: 10px;
  font-weight: 600;
}

.favorites-loading.hidden {
  display: none;
}

.favorites-loading-spinner {
  width: 0.55rem;
  height: 0.55rem;
  border: 2px solid currentColor;
  border-top-color: transparent;
  border-radius: 999px;
  animation: favorites-loading-spinner 0.8s linear infinite;
}

@keyframes favorites-loading-spinner {
  to {
    transform: rotate(360deg);
  }
}

#statusMessage {
  border-top: 1px solid var(--nenya-border-soft);
  background: color-mix(in oklch, var(--color-base-100) 88%, transparent);
  backdrop-filter: blur(10px);
}

.modal-box {
  border-radius: var(--nenya-radius-lg);
  border: 1px solid var(--nenya-border-soft);
  box-shadow: var(--nenya-shadow-soft);
}

#saveToUnsortedModal .modal-box {
  overflow-y: visible;
}

#projectsErrorContainer.flex {
  display: flex;
}

/* Favorites chips */
#favoritesContainer {
  user-select: none;
}


/* Adjust for side panel if needed */
@media (min-width: 481px) {
  html {
    width: 100%;
  }
  body {
    width: 100%;
    max-width: 100%;
    height: 100vh;
  }
}
